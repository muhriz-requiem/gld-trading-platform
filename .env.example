# Runtime configuration for GLD Trading Platform.
#
# Copy to `.env`. Every value is optional. The original .env held live Alpaca
# paper and live credentials and was committed to this repository by mistake in an
# early commit; all such keys have since been rotated and the published history is a
# single squashed commit that never contained a .env file.

# --- runtime mode ---
# backtest | paper | live
# LIVE requires BOTH strict_mode=true (blocks it) or an explicit allow flag. Read
# src/runtime/execution_router.py before changing anything here.
RUNTIME_MODE=backtest

# --- instrument ---
SYMBOL=GLD

# --- safety gates ---
# STRICT_MODE=true blocks LIVE mode outright.
STRICT_MODE=true

# ALLOW_LIVE_TRADING must be true AND STRICT_MODE false for LIVE to route.
# Note: src/brokers/alpaca_paper_broker.py pins its endpoint to paper regardless.
ALLOW_LIVE_TRADING=false

# --- Alpaca credentials (paper only) ---
# Prefer the _PAPER names. The un-suffixed names are accepted as a legacy fallback.
ALPACA_API_KEY_PAPER=
ALPACA_SECRET_KEY_PAPER=
